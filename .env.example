# Anthropic API key from https://console.anthropic.com (set this in Vercel → Project → Settings → Environment Variables)
ANTHROPIC_API_KEY=

# Set to 1 to return fixed test answers instead of calling Claude (used by tests)
FAKE_AI=

# Tech Helper Plus (Razorpay Subscriptions). Leave empty and the app shows "Payments aren't available yet".
# Test keys (rzp_test_…) first; live keys after KYC. See README → Tech Helper Plus.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The ₹99 monthly plan you created in the Razorpay dashboard (plan_…)
RAZORPAY_PLAN_ID=
# A long random string you make up (at least 16 characters), e.g. `openssl rand -base64 32`
ENTITLEMENT_SECRET=

# Set to 1 for a pretend Razorpay inside the server (used by tests). Ignored on a Vercel production deployment.
FAKE_BILLING=
